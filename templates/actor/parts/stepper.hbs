<span class="stepper">
  <a data-action="adjust" data-path="{{path}}" data-delta="1" data-min="0" data-max="{{max}}"
     data-tooltip="BETYARSORS.Label.Increase">▲</a>
  <a data-action="adjust" data-path="{{path}}" data-delta="-1" data-min="0" data-max="{{max}}"
     data-tooltip="BETYARSORS.Label.Decrease">▼</a>
</span>
